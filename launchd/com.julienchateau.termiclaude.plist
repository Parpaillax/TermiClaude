<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Modele de LaunchAgent : le chemin __TERMICLAUDE_BIN__ est resolu par install.sh
         qui ecrit la version finale dans ~/Library/LaunchAgents/. -->
    <key>Label</key>
    <string>com.julienchateau.termiclaude</string>

    <key>ProgramArguments</key>
    <array>
        <string>__TERMICLAUDE_BIN__</string>
    </array>

    <!-- Lance au login et relance si le process meurt. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__TERMICLAUDE_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__TERMICLAUDE_LOG__</string>
</dict>
</plist>
